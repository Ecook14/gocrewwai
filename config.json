{
  "llm": {
    "default_model": "smart",
    "failover_model": "creative",
    "failover_enabled": true,
    "max_retries": 3,
    "timeout": "300s",
    "pricing_ttl": "6h",
    "max_budget_usd": 10.0
  },
  "providers": {
    "openai": {
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}"
    },
    "anthropic": {
      "name": "Anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "api_key": "${ANTHROPIC_API_KEY}"
    },
    "google": {
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key": "${GOOGLE_API_KEY}"
    }
  },
  "routing": {
    "default": "smart",
    "vision": "smart",
    "rag": "fast",
    "long_context": "creative",
    "code_generation": "creative"
  },
  "orchestration": {
    "supervisor_model": "smart",
    "researcher_model": "fast",
    "architect_model": "smart",
    "implementer_model": "creative"
  },
  "models": {
    "smart": {
      "provider_id": "openai",
      "model_id": "gpt-4o",
      "name": "GPT-4o (Smart)"
    },
    "creative": {
      "provider_id": "anthropic",
      "model_id": "claude-3-5-sonnet-20240620",
      "name": "Claude 3.5 Sonnet (Creative)"
    },
    "fast": {
      "provider_id": "google",
      "model_id": "gemini-1.5-pro",
      "name": "Gemini 1.5 Pro (Fast)"
    }
  },
  "mcp_servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data"]
    }
  },
  "tools": {
    "e2b": {
      "base_url": "https://api.e2b.dev",
      "api_key": "${E2B_API_KEY}"
    },
    "shell": {
      "safe_mode": true,
      "allowed_commands": ["ls", "grep", "cat", "echo", "go", "python3"],
      "timeout": "30s"
    },
    "directory": {
      "root_path": ".",
      "max_depth": 5,
      "allow_absolute": false
    }
  },
  "memory": {
    "chroma_timeout": "15s",
    "embedding_model": "text-embedding-3-small"
  },
  "persistence": {
    "sessions": {
      "driver": "sqlite",
      "connection_string": "crew_state.db",
      "checkpoint_interval": "1m"
    },
    "cache": {
      "type": "redis",
      "redis": {
        "addr": "${REDIS_ADDR}",
        "password": "${REDIS_PASSWORD}",
        "db": 0,
        "ttl": "72h"
      }
    }
  },
  "observability": {
    "enabled": true,
    "service_name": "crew-go-engine",
    "prometheus": {
      "enabled": true,
      "port": 9090
    },
    "splunk": {
      "enabled": false,
      "endpoint": "${SPLUNK_OTLP_ENDPOINT}",
      "token": "${SPLUNK_ACCESS_TOKEN}"
    },
    "tracing": {
      "sampling_rate": 1.0,
      "exporter": "otlp"
    }
  },
  "security": {
    "shell_allow_list": ["ls", "grep", "cat", "echo", "go", "python3", "npm", "git"],
    "file_chroot": "./workspace",
    "max_file_size_mb": 10
  },
  "hitl": {
    "enabled": true,
    "default_mode": "prompt",
    "timeout_seconds": 3600
  }
}
